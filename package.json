{
  "name": "qla-lms-platform",
  "version": "2.0.0",
  "description": "Qatar Leadership Academy Interactive Mathematics Learning Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "railway-fix": "node railway-fix.js",
    "postinstall": "node railway-fix.js"
    "dev": "nodemon server.js",
    "build": "npm run setup:dirs && npm run migrate",
    "setup": "npm run setup:dirs && npm run migrate && npm run verify",
    "setup:dirs": "node scripts/setup-directories.js || echo 'Directory setup skipped'",
    "migrate": "node migrations/init.js || echo 'Migration skipped'",
    "sync": "node scripts/sync-lessons.js || echo 'Sync skipped'",
    "verify": "node scripts/verify-deployment.js || echo 'Verification skipped'",
    "fix": "node scripts/fix-deployment.js",
    "test": "mocha test/test.suite.js --timeout 10000",
    "test:watch": "mocha test/test.suite.js --watch",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "seed": "node scripts/seed-data.js",
    "backup": "node scripts/backup-database.js",
    "railway-build": "npm install && npm run build",
    "docker:build": "docker build -t qla-lms .",
    "docker:run": "docker run -p 3000:3000 --env-file .env qla-lms",
    "docker:compose": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "connect-pg-simple": "^9.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.1",
    "nodemailer": "^6.9.7",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "dayjs": "^1.11.10",
    "lodash": "^4.17.21",
    "sanitize-html": "^2.11.0",
    "sharp": "^0.33.1",
    "bull": "^4.11.5",
    "redis": "^4.6.11",
    "winston": "^3.11.0",
    "morgan": "^1.10.0",
    "@anthropic-ai/sdk": "^0.16.1",
    "openai": "^4.24.1",
    "natural": "^6.10.0",
    "mathjs": "^12.2.1",
    "papaparse": "^5.4.1",
    "xlsx": "^0.18.5",
    "pdfkit": "^0.14.0",
    "qrcode": "^1.5.3",
    "node-cron": "^3.0.3",
    "express-fileupload": "^1.4.3",
    "cookie-parser": "^1.4.6",
    "express-mongo-sanitize": "^2.2.0",
    "xss": "^1.0.14",
    "hpp": "^0.2.3",
    "express-session-sequelize": "^2.3.0",
    "connect-redis": "^7.1.0",
    "ioredis": "^5.3.2",
    "celebrate": "^15.0.3",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "supertest": "^6.3.3",
    "sinon": "^17.0.1",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.1.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.3.0",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "npm-run-all": "^4.1.5"
  },
  "keywords": [
    "lms",
    "education",
    "mathematics",
    "qatar",
    "learning",
    "interactive",
    "assessment",
    "classroom",
    "realtime",
    "websocket",
    "e-learning",
    "edtech",
    "qla",
    "teaching",
    "student-management"
  ],
  "author": "QLA Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qla/mathematics-lms.git"
  },
  "bugs": {
    "url": "https://github.com/qla/mathematics-lms/issues"
  },
  "homepage": "https://qla.up.railway.app",
  "private": false,
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "nodemonConfig": {
    "watch": [
      "server.js",
      "routes/",
      "services/",
      "migrations/"
    ],
    "ext": "js,json",
    "ignore": [
      "test/*",
      "public/*",
      "uploads/*"
    ],
    "delay": "2500",
    "env": {
      "NODE_ENV": "development"
    }
  },
  "eslintConfig": {
    "extends": "airbnb-base",
    "env": {
      "node": true,
      "es2021": true,
      "mocha": true
    },
    "rules": {
      "no-console": "off",
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ],
      "comma-dangle": [
        "error",
        "never"
      ],
      "max-len": [
        "error",
        {
          "code": 120
        }
      ]
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "none",
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 2
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "*.json": [
      "prettier --write",
      "git add"
    ]
  },
  "directories": {
    "test": "test",
    "lib": "services"
  },
  "config": {
    "port": 3000,
    "host": "0.0.0.0"
  }
}


