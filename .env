# QLA LMS Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=production
PORT=3000
CLIENT_URL=https://your-app-name.up.railway.app

# Database Configuration (Railway PostgreSQL)
DATABASE_URL=postgresql://postgres:password@host:port/railway

# Session Configuration
SESSION_SECRET=your-very-long-random-session-secret-key-here

# Google OAuth Configuration
# Get these from Google Cloud Console (https://console.cloud.google.com)
# Create OAuth 2.0 Client ID for Web Application
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AWS S3 Configuration (Optional - for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=qla-lms-uploads

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@qla.qfschools.qa
SMTP_PASS=your-email-password

# Application Settings
PASS_PERCENTAGE=70
ASSESSMENT_TIME_LIMIT=15
MAX_FILE_SIZE=104857600
ALLOWED_EMAIL_DOMAIN=@qla.qfschools.qa

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Sentry Configuration (Optional - for error tracking)
SENTRY_DSN=your-sentry-dsn

# Analytics Configuration (Optional)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token
