# QLA LMS Environment Variables
# For Railway Deployment

# Server Configuration
NODE_ENV=production
PORT=3000

# Use Railway's provided DATABASE_URL (automatically injected)
# Or set your own PostgreSQL connection string
# DATABASE_URL is automatically provided by Railway when you add PostgreSQL

# Session Configuration (REQUIRED - use a random string)
SESSION_SECRET=qla-lms-secret-2024-mohammad-abughuwaleh-teacher-portal

# Google OAuth (Optional - leave empty for demo mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Application Settings
ALLOWED_EMAIL_DOMAIN=@qla.qfschools.qa
PASS_PERCENTAGE=70
ASSESSMENT_TIME_LIMIT=15
MAX_FILE_SIZE=104857600

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Redis (Optional - Railway can provide this)
REDIS_URL=

# Railway will automatically set:
# - RAILWAY_STATIC_URL
# - RAILWAY_PUBLIC_DOMAIN
# - DATABASE_URL (if you add PostgreSQL service)
